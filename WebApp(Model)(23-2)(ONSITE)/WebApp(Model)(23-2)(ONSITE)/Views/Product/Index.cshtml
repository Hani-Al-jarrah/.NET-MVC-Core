@model IEnumerable<WebApp_Model__23_2__ONSITE_.Models.Product>

@{
    ViewData["Title"] = "Products Page";
}

<h2 class="text-center my-4">Products Page</h2><br />
@Html.ActionLink("Add New Product", "Create", "Product", null, new { @class = "btn btn-primary" })

<div class="container">
    <div class="row">
        @foreach (var product in Model)
        {
            <div class="col-md-4">
                <div class="card mb-4 shadow-sm">
                    <img src="@product.Image" class="card-img-top" alt="@product.Name" style="height: 200px; object-fit: cover;">
                    <div class="card-body">
                        <h5 class="card-title">@product.Name</h5>
                        <p class="card-text">@product.Description</p>
                        <p class="card-text"><small class="text-muted">@product.Details</small></p>
                        <p><strong>Price:</strong> @product.Price J.D🤑💸 </p>
                        <div class="d-flex justify-content-between">
                            <a href="@Url.Action("Details", "Product", new { id = product.Id })" class="btn btn-primary">View Details</a>
                            <a href="@Url.Action("Edit", "Product", new { id = product.Id })" class="btn btn-warning">Edit</a>

                            <form method="post" action="@Url.Action("Delete", "Product")" onsubmit="return confirm('Are you sure you want to delete this product?');">
                                <input type="hidden" name="id" value="@product.Id" />
                                <button type="submit" class="btn btn-danger">Delete</button>
                            </form>


                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
