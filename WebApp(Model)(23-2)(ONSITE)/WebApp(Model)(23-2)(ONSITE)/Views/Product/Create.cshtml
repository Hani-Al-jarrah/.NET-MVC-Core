@model WebApp_Model__23_2__ONSITE_.Models.Product

<h2>Add New Product</h2>

<form method="post" action="~/Product/Create">
    <label>Name:</label>
    <input type="text" asp-for="Name" required /><br>

    <label>Price:</label>
    <input type="text" asp-for="Price" required /><br>

    <label>Description:</label>
    <input type="text" asp-for="Description" required /><br>

    <label>Details:</label>
    <input type="text" asp-for="Details" required /><br>

    <label>Image:</label>
    <input type="text" asp-for="Image" required /><br>

    <button type="submit">Save</button>
</form>

<a asp-controller="Products" asp-action="Index">Back to List</a>

