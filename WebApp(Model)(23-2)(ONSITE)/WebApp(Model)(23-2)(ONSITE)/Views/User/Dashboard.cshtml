
@model IEnumerable<WebApp_Model__23_2__ONSITE_.Models.User>

<h2>Users List</h2>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.Id</td>
                <td>@user.Name</td>
                <td>@user.Email</td>
                <td>@user.Role</td>
                <td>
                    @Html.ActionLink("Edit", "Edit", "User", new { id = user.Id })
                    @Html.ActionLink("Details", "Details", "User", new { id = user.Id })

                    <form method="post" action="~/User/Delete" onsubmit="return confirm('Are you sure you want to delete this user?');">
                        <input type="text" name="id" value="@user.Id" />
                        <button type="submit">Delete</button>
                    </form>


                </td>
            </tr>
        }
    </tbody>
</table>

@Html.ActionLink("Add New User", "Create", "User", null, new { @class = "btn btn-primary" })



